# HuahuaApi 视频生成配置模板
# 复制本文件后只改 HUAHUA_API_KEY 一行即可跑起来（其余都有合理默认值）：
#   cp env.sample huahuaapi.env
#   python hh_video.py check --env huahuaapi.env
# ⚠️ 内含密钥，加入 .gitignore，不要提交到仓库、不要放进交付目录。

# ── 1. 必填 ────────────────────────────────────────────────
# 接口地址，默认就是 HuahuaApi，一般不用改
HUAHUA_API_BASE=https://api.huahuaapi.com/v1

# 在 https://huahuatv.lol 控制台生成的密钥（sk- 开头）。务必先充值再提交。
HUAHUA_API_KEY=sk-在这里填你的密钥

# 默认模型；不给 --model 时用它。可用的看：python hh_video.py models
HUAHUA_MODEL=sd-2.5

# ── 2. 可选：失败轮换队列 ──────────────────────────────────
# run 子命令会按顺序尝试，某个提交失败就换下一个（失败不计费）
HUAHUA_MODEL2=seedance-2.5s
HUAHUA_MODEL3=seedance2.5-a

# ── 3. 可选：默认生成参数 ──────────────────────────────────
# 会被命令行的 --duration / --size / --param 覆盖
# 注意：Seedance / SD 系列时长字段是 duration（不是 seconds）
HUAHUA_MODEL_PARAMS={"duration":10,"size":"1280x720"}

# ── 4. 参考图字段（图生视频用）──────────────────────────────
HUAHUA_ASSET_KEY=reference_images

# ── 5. 鉴权与网络 ──────────────────────────────────────────
HUAHUA_AUTH_SCHEME=Bearer
# 生成可能同步阻塞好几分钟（30 秒视频常见 10~25 分钟排队），读超时必须放宽
HUAHUA_HTTP_TIMEOUT=600
# /content 下载端点需要带鉴权头，保持 1
HUAHUA_DOWNLOAD_AUTH=1

# ── 6. 可选：本地图传公共图床（图生视频需要公网 URL）────────
# 聚合站侧没有通用文件上传端点时，用公共图床兜底（URL 有时效，出片后及时归档）
HUAHUA_UPLOAD_ENDPOINT=https://uguu.se/upload
HUAHUA_UPLOAD_FIELD=files[]
HUAHUA_UPLOAD_URL_KEYS=files[0].url

# ── 兼容性说明 ─────────────────────────────────────────────
# 所有 HUAHUA_* 都可以用 R2V_* 的同名变量代替（如 R2V_API_KEY / R2V_MODEL /
# R2V_MODEL_PARAMS / R2V_UPLOAD_ENDPOINT），两套写法脚本都能识别，
# fight-scene-r2v-delivery 那套 env 可以直接 --env 指过来复用。
